# Copy to `.env` (git-ignored) to override the defaults. Every value is read
# when Vite starts (`yarn example:dev`) or builds (`yarn example:build`); a
# variable set in the shell wins over this file.

# Phoenix REST API base URL and socket endpoint.
# Defaults: http://localhost:4000/api and ws://localhost:4000/socket under
# `vite dev`; `/api` and `/socket` (same origin) in a build, which is right when
# Phoenix serves the app at /app/example/.
# VITE_API_URL=http://localhost:4000/api
# VITE_WS_URL=ws://localhost:4000/socket

# Port of the Vite dev server. Default: 5001. The backend only accepts
# browsers from the origins on its CORS list (in development: localhost ports
# 3000, 5173, 5001, 5010, 4321 and 8788; see CORS_ORIGINS in the root
# .env.example).
# VITE_PORT=5001
