# Copy to `.env` (git-ignored) to override the defaults; a variable set in the shell wins.

# Defaults: localhost:4000 under `vite dev`; same origin (`/api`, `/socket`) in a build.
# VITE_API_URL=http://localhost:4000/api
# VITE_WS_URL=ws://localhost:4000/socket

# Vite dev server port (default: `port` of app.config.ts). Must be on the backend's CORS list.
# VITE_PORT=5001
