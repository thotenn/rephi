{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // Node's type stripping (Vite's config loader) needs the `.ts` extension in imports.
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "strict": true
  },
  "include": ["vite.config.ts", "app.config.ts"]
}