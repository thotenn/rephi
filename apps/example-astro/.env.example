# Copy to `.env` to override the defaults. Read at build time, not at request time.

# Absolute URLs when the site is hosted on another origin; `/api` and `/socket` work when Phoenix serves it.
PUBLIC_API_URL=http://localhost:4000/api
PUBLIC_WS_URL=ws://localhost:4000/socket

# Sub-path the site is served from; unset means "/".
# ASTRO_BASE=/app/example-astro
