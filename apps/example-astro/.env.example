# Copy to `.env` (git-ignored) to override the defaults. All values are read
# when the site is built (`astro dev` / `astro build`), not at request time.

# Phoenix REST API base URL and socket endpoint. Absolute URLs when the site is
# hosted on another origin (Cloudflare Pages); `/api` and `/socket` also work
# when Phoenix serves the site itself.
PUBLIC_API_URL=http://localhost:4000/api
PUBLIC_WS_URL=ws://localhost:4000/socket

# Sub-path the site is served from. Leave unset for "/" (Cloudflare Pages).
# ASTRO_BASE=/app/example-astro
