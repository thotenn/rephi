---
import { ClientRouter } from "astro:transitions";
import AppRuntime from "~/islands/AppRuntime";
import GuestRedirect from "~/islands/GuestRedirect";
import { asset, href, ROUTES } from "~/lib/routes";
import "~/styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  guestOnly?: boolean;
}

const {
  title,
  description = "Rephi example frontend built with Astro on top of the Phoenix API.",
  noindex = false,
  guestOnly = false,
} = Astro.props;

const homeUrl = href(ROUTES.home);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={asset("favicon.ico")} />
    <title>{`${title} · Rephi`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    {/* Redirects a signed-in visitor before the first paint; GuestRedirect stays the authoritative check. */}
    {
      guestOnly && (
        <script is:inline define:vars={{ homeUrl }}>
          try {
            if (document.readyState === "loading" && window.self === window.top) {
              const session = JSON.parse(localStorage.getItem("auth-storage") || "{}");
              if (session.state && session.state.isAuthenticated) location.replace(homeUrl);
            }
          } catch {
            // Storage unavailable or unreadable: the island decides.
          }
        </script>
      )
    }
  </head>
  <body>
    {guestOnly && <GuestRedirect client:only="react" />}
    <slot />
    {/* transition:persist keeps the socket open and the toasts visible across navigations. */}
    <AppRuntime client:only="react" transition:persist="app-runtime" />
    <script>
      import { skipDevIframePreload } from "~/lib/dev-navigation";

      if (import.meta.env.DEV) skipDevIframePreload();
    </script>
  </body>
</html>
