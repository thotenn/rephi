---
import AppHeader from "~/components/AppHeader.astro";
import RouteGuard from "~/islands/RouteGuard";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  heading?: string;
  permission?: string;
}

const { title, heading, permission } = Astro.props;
---

<BaseLayout title={title} noindex>
  <RouteGuard client:only="react" permission={permission}>
    <div class="min-h-screen bg-gray-50">
      <AppHeader heading={heading} />
      <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div class="px-4 py-6 sm:px-0">
          <slot />
        </div>
      </main>
    </div>

    <div slot="fallback" class="min-h-screen flex items-center justify-center">
      <div class="animate-pulse text-lg text-gray-600">Loading...</div>
    </div>
  </RouteGuard>
</BaseLayout>
