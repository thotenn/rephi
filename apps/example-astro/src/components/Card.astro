---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={["bg-white overflow-hidden shadow rounded-lg", className]}>
  <div class="px-4 py-5 sm:p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">{title}</h2>
    <slot />
  </div>
</div>
