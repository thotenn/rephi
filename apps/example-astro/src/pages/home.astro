---
import Card from "~/components/Card.astro";
import NotificationSender from "~/islands/NotificationSender";
import RealtimeHint from "~/islands/RealtimeHint";
import UserInfoCard from "~/islands/UserInfoCard";
import AppLayout from "~/layouts/AppLayout.astro";
---

<AppLayout title="Home">
  {/* client:only - shows the signed-in user, who is only known in the browser. */}
  <UserInfoCard client:only="react" />

  {/*
    client:only - what it offers depends on the user's permissions, and it
    displays the live socket state; neither is known at build time.
  */}
  <NotificationSender client:only="react" />

  <Card title="Welcome!" class="mt-8">
    <p class="text-gray-600">
      You have successfully logged into your Rephi account. This is your
      home dashboard where you can manage your account and access all the
      features of the application.
    </p>
    {/* client:only - the live socket state has no build-time value. */}
    <RealtimeHint client:only="react" />
  </Card>
</AppLayout>
