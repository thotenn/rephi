{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".wrangler"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
