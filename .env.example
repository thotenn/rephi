# Environment variables for Rephi.
#
# Development: copy this file to `.env` and uncomment what you want to change.
# Nothing here is required in development - a fresh clone boots without a
# `.env` file. The file is loaded by config/dotenv.exs in the dev environment
# only; variables already set in your shell win over it, and `mix test` never
# reads it.
#
# Production: set these in the real environment of the release (the file is
# not read there). The ones marked REQUIRED IN PRODUCTION stop the boot with
# an error when they are missing.
#
# Syntax: KEY=value, optional `export `, "double" or 'single' quotes, and
# comments after a space and `#`. An empty value counts as not set.

# --- Server ---------------------------------------------------------------

# HTTP port. Default: 4000.
# PORT=4000

# Public host name of the API (no scheme, no port). REQUIRED IN PRODUCTION.
# It builds URLs and is what the WebSocket origin check compares against.
# PHX_HOST=api.example.com

# --- Secrets ---------------------------------------------------------------
# Development has throwaway values for both. Never reuse them, and give every
# deployment its own.

# Signs and encrypts cookies. REQUIRED IN PRODUCTION.
# Generate one with: mix phx.gen.secret
# SECRET_KEY_BASE=

# Signs every JWT: whoever knows it can impersonate any user.
# REQUIRED IN PRODUCTION, at least 32 bytes.
# Generate one with: mix guardian.gen.secret
# GUARDIAN_SECRET_KEY=

# --- Database --------------------------------------------------------------

# Development (defaults shown).
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_HOSTNAME=localhost
# DB_NAME=rephi_dev
# DB_POOL_SIZE=10

# Production. DATABASE_URL is REQUIRED IN PRODUCTION.
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# POOL_SIZE=10
# ECTO_IPV6=false

# --- Authentication --------------------------------------------------------

# Lifetime of a login token, in seconds. Default: 86400 (24 hours).
# There is no refresh token: after this the user logs in again.
# TOKEN_TTL_SECONDS=86400

# First administrator, created by `mix run priv/repo/seeds.exs` (and
# `mix ecto.setup`). REQUIRED to seed any environment but development, where
# the well-known admin@admin.com account is used when they are not set.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- Browsers on other origins ---------------------------------------------

# Frontends served from another origin that may call the API (CORS),
# comma separated. Exact origins, or a wildcard for the first label of the
# host for preview deployments. Never `*`.
# Default: the local frontend dev servers in development, none in production.
# CORS_ORIGINS=https://app.example.com,https://*.example.pages.dev

# WebSocket origin check: `true` (only PHX_HOST), `false` (no check) or a
# comma separated list of origins. Default: off in development; PHX_HOST plus
# CORS_ORIGINS in production.
# CHECK_ORIGIN=true

# --- Hardening -------------------------------------------------------------

# Production redirects HTTP to HTTPS (taking the scheme from
# X-Forwarded-Proto) and sends HSTS. Set to false only if something else
# guarantees HTTPS. Default: true. Production only.
# FORCE_SSL=true

# Swagger UI (/api/swagger) and swagger.json. Default: on in development,
# off in production.
# SWAGGER_ENABLED=false

# Throttling of login and registration, per client IP and route.
# Default: on; 10 logins and 5 registrations per 60 seconds.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_WINDOW_SECONDS=60

# Number of reverse proxies in front of the app whose X-Forwarded-For entry
# is trusted for the client IP. Default: 0 (the header is ignored, so behind
# a proxy every client shares one counter). Only set it if every request
# goes through those proxies.
# RATE_LIMIT_TRUSTED_PROXIES=1

# --- Clustering (production) ------------------------------------------------

# DNS name that resolves to the other nodes of the cluster.
# DNS_CLUSTER_QUERY=
