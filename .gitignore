# --- Elixir / Mix ------------------------------------------------------------

# Compiled artifacts and dependencies (the project and the installer).
/_build/
/deps/
/installer/_build/
/installer/deps/
/installer/doc/
/installer/tmp/

# `mix test --cover` output.
/cover/

# Documentation generated by ExDoc.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump.
erl_crash.dump

# Archives built with `mix archive.build` (the installer).
*.ez

# Temporary files, for example, from tests.
/tmp/

# --- Generated at build time ---------------------------------------------------

# `mix phx.swagger.generate` (run by `mix setup` and by the release build).
/priv/static/swagger.json

# Frontend builds copied by scripts/copy-builds.js (`yarn build`).
/priv/static/apps/

# --- Environment -----------------------------------------------------------------

# Local configuration and secrets. `.env.example` is the documented template.
.env
.env.local
.env.*.local

# --- Node.js / Yarn ----------------------------------------------------------------

/node_modules/
/apps/*/node_modules/
/packages/*/node_modules/
/apps/*/dist/
/apps/*/.vite/
/packages/*/dist/

# Yarn 4 (Corepack) install state and cache; the lockfile is tracked.
.yarn/

# --- Editors and OS ----------------------------------------------------------------

.elixir_ls/
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store
